# Copy this file to .env and replace the values. .env is gitignored.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# Compose substitutes these into docker-compose.yml; it does not read .env inside the container.

# Signing key for JWTs. Must be at least 32 bytes; jjwt picks the HMAC algorithm by length.
# Generate one: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-text

# Passwords for the two accounts UserSeeder creates on first start.
SEED_ADMIN_PASSWORD=replace-me
SEED_ANALYST_PASSWORD=replace-me
